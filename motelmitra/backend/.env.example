# Copy this file to .env and fill in your values
# Leave as is: a random key is made on first start (backend/.secret_key). Set your own long random text when hosting.
SECRET_KEY=change-me-to-a-long-random-string
# Keep False. True shows program code on error pages.
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

# yes = phones, tablets and other PCs on the WiFi can open MotelMitra (needed for "Use phone" photos)
# no  = only this PC (http://localhost:5173)
HOST_ON_WIFI=yes

# yes = show < > scroll buttons on wide grids (hover the grid). no = hide them
GRID_SCROLL_BUTTONS=yes

# mysql (default) or sqlite (quick test without MySQL)
DB_ENGINE=mysql
DB_NAME=motelmitra
DB_USER=motelmitra_user
DB_PASSWORD=YourStrongPassword
DB_HOST=127.0.0.1
DB_PORT=3306

# Motel time zone (affects "today" and daily reports)
TIME_ZONE=America/Chicago

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
